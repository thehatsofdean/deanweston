---
import "../styles/site.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { formatDate } from "../utils/date";

// Get all journal posts
const journalEntries = await getCollection("journal");

// Sort newest first
const sortedJournalEntries = journalEntries.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

// Latest entry
const latestJournalEntry = sortedJournalEntries[0];

// Useful values for template
const latestJournalTitle = latestJournalEntry?.data.title;
const latestJournalSummary = latestJournalEntry?.data.description;
const latestJournalUrl = latestJournalEntry
  ? `/journal/${latestJournalEntry.id}/`
  : null;
const latestJournalPubDate = latestJournalEntry?.data.pubDate;
---

<BaseLayout title="Front-End Developer &amp; Digital Consultant (Higher Education)">
      <section class="panel panel--intro panel-has-bg panel-has-bg--blue panel--centered">
        <div class="panel__image panel__image--wayne"></div>
        <div class="grid-wrapper content">
          <h1 class="content-col">
            <span class="pre-heading">Dean Weston</span>
            <span class="visually-hidden">&thinsp;&mdash;&thinsp;</span>
            <span class="heading--lg"
              >CMS architect, web developer & East Midlands Hat Wearer of the
              Year (1993).</span
            >
          </h1>
          <p class="content-col">
            <a href="/about" class="cta">Whats under that hat</a>
          </p>
        </div>
      </section>


      <section class="panel panel-has-bg panel-has-bg--pink">
        <div class="panel__image panel__image--sherlock"></div>
        <div class="grid-wrapper content">
          <div class="content-col">
            <h2 class="pre-heading">Thinking Cap</h2>
            {latestJournalEntry ? (
        <article>
          <h3 class="heading--lg">
            {latestJournalTitle}
          </h3>
          <p><a href={latestJournalUrl} class="cta">Read article</a></p>
        </article>
      ) : (
        <p>No journal entries yet.</p>
      )}
      <p><a href="./journal" class="cta">More articles</a></p>
          </div>

   
        </div>
      </section>
</BaseLayout>

