---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import { getCollection, render } from "astro:content";
import { formatDate } from "../../utils/date";
import { calculateReadingTime } from "../../utils/readingTime";

export async function getStaticPaths() {
  const posts = await getCollection("journal", ({ data }) => !data.draft);

  const sortedPosts = [...posts].sort((a, b) => {
    const dateDiff =
      new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime();

    if (dateDiff !== 0) return dateDiff;

    return a.id.localeCompare(b.id);
  });

  return sortedPosts.map((post, index) => {
    const nextPost =
      sortedPosts.length > 1
        ? sortedPosts[(index + 1) % sortedPosts.length]
        : null;

    return {
      params: { slug: post.id },
      props: {
        post,
        nextRead: nextPost
          ? {
              href: `/journal/${nextPost.id}/`,
              title: nextPost.data.title,
            }
          : null,
      },
    };
  });
}


const { post, nextRead } = Astro.props;
const { Content } = await render(post);

const articleUrl = `https://www.deanweston.co.uk/journal/${post.id}/`;
const readingTime = calculateReadingTime(post.body ?? "");

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${articleUrl}#article`,
  url: articleUrl,
  headline: post.data.title,
  description: post.data.description,
  datePublished: new Date(post.data.pubDate).toISOString(),
  author: {
    "@id": "https://www.deanweston.co.uk/#person",
  },
  publisher: {
    "@id": "https://www.deanweston.co.uk/#person",
  },
  isPartOf: {
    "@id": "https://www.deanweston.co.uk/#website",
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": articleUrl,
  },
};

---

<BaseLayout title={post.data.title} bodyClass="j-entry" preloadImage="/img/sherlock-pop.webp">
  
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(articleSchema)}
  />

  <section class="panel panel--intro panel-has-bg panel-has-bg--pink panel--centered">
    <div class="panel__image panel__image--sherlock"></div>
    <div class="grid-wrapper content">
      <div class="content-col">
        <h1>
          <span class="pre-heading">{formatDate(post.data.pubDate)}</span>
          <span class="visually-hidden">&thinsp;&mdash;&thinsp;</span>
          <span class="heading--lg">{post.data.title}</span>
        </h1>
        <div class="read-time">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-clock preview-icon" aria-hidden="true">
            <path d="M16 22h2a2 2 0 0 0 2-2V8a2.4 2.4 0 0 0-.706-1.706l-3.588-3.588A2.4 2.4 0 0 0 14 2H6a2 2 0 0 0-2 2v2.85"/>
            <path d="M14 2v5a1 1 0 0 0 1 1h5"/>
            <path d="M8 14v2.2l1.6 1"/>
            <circle cx="8" cy="16" r="6"/>
          </svg>   
          <span>
          {readingTime.text}
          </span>
        </div>
      </div>
    </div>
  </section>

  <section class="panel">
    <div class="grid-wrapper content">
      <div class="content-col content-col--narrow">
        <article class="j-entry__content prose">
          <Content/>
        </article>
        <nav class="j-entry__footer-nav">
        {nextRead && (
                  <h3 class="j-entry__footer-title">
                  <span class="j-entry__footer-pre-title">Next article:</span>
                  {nextRead.title}
                  </h3>
                  <p class="buttons-block">  
                 <Button href={nextRead.href} variant="pink-fill" rel="next">
                      Read now
                    </Button>
                    <Button href="../../journal" variant="pink-fill" type="secondary">
                      More articles
                    </Button>
                  </p>
                )}
        </nav>
      </div>
    </div>
  </section>
</BaseLayout>